# ---------------------------------------------------------------------------
# Marketplace Arbitrage — configuration
# Copy to `.env` and fill in. Only the eBay credentials are required.
#
# Most of the tuning knobs below are also editable live in the dashboard
# (Settings page), which persists them to data/settings_override.json. The
# values here are the defaults used before any override exists.
# ---------------------------------------------------------------------------

# --- Runtime / storage ------------------------------------------------------
ENV=dev                       # "dev" (pretty logs) or "prod" (JSON logs)
LOG_LEVEL=INFO
DB_PATH=data/arb.db           # SQLite file (mounted as a volume in Docker)

# --- eBay Browse API (REQUIRED) ---------------------------------------------
# Free at developer.ebay.com — 5,000 calls/day, no card needed.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_GB
EBAY_DAILY_CALL_LIMIT=5000    # the free tier's allowance; raise if eBay grants more
EBAY_LIMIT=50                 # listings fetched per watched search

# Marketplace Insights (real sold data) is a limited release that eBay no
# longer grants to new applicants. Leave false unless your app was approved —
# the system builds its own sold history instead (see SOLD-PRICE TRACKING).
EBAY_HAS_INSIGHTS=false

# Seed searches for a fresh install. After the first run the watch list lives
# in the database and is edited in the UI or via `arb watch`.
EBAY_QUERIES=                 # e.g. "iphone 12,ps5,sony wh-1000xm4"
EBAY_CATEGORY_ID=             # optional eBay category id (e.g. 9355 = mobile phones)
EBAY_MAX_PRICE=               # optional max buy-it-now price to consider

# --- Comp selection ---------------------------------------------------------
COMP_SEARCH_LIMIT=100         # comps requested per valuation
MIN_COMP_RELEVANCE=0.6        # fraction of the listing's key words a comp must match
MIN_COMPS=4                   # kept comps needed to price at all
MIN_CONDITION_COMPS=3         # same-condition comps needed before pricing off them
VALUATION_SAMPLE_SIZE=8       # comps kept on a valuation for the UI's audit panel

# --- Valuation model --------------------------------------------------------
ACTIVE_TO_SOLD_RATIO=0.88     # default asking->sold discount (auto-calibrated later)
CALIBRATION_MIN_KEYS=15       # paired product keys needed before trusting a learned ratio
USED_TO_NEW_RATIO=0.75        # default used/new ratio when comps are one-sided
MIN_SOLD_COMPS=5              # observed sales needed to prefer sold over asking prices
SOLD_WINDOW_DAYS=90           # look-back window for observed sales
CONFIDENCE_TARGET_COMPS=12    # comp count at which sample-size confidence saturates
CONFIDENCE_MAX_CV=0.5         # dispersion at which spread confidence hits zero
VALUATION_TTL_HOURS=24        # re-value a product only if the cache is older than this

# --- Sold-price tracking (the free alternative to Marketplace Insights) -----
# Comps are watched over time; ones that vanish from search are checked, and
# ended listings become observed sales. This is what makes free sold data work.
COMP_STALE_HOURS=36           # how long a comp must be missing before it is checked
SOLD_SWEEP_MAX_CHECKS=150     # max ended-listing checks per run (1 API call each)

# --- Keepa (Amazon data) — OPTIONAL, PAID -----------------------------------
# Leave blank to run entirely on free data. Amazon is only used as a secondary
# sell channel when a key is present.
KEEPA_API_KEY=
KEEPA_DOMAIN=2                # 1=US, 2=UK, 3=DE ... match your marketplace

# --- Deal thresholds --------------------------------------------------------
MIN_PROFIT=25                 # minimum £ profit to flag a deal
MIN_ROI=30                    # minimum ROI %
MIN_EXPECTED_PROFIT=15        # minimum risk-adjusted £ profit
MIN_CONFIDENCE=0.35           # minimum valuation confidence (0-1) to trust a deal
MIN_SCORE=0                   # minimum composite score (0-100)
MAX_AMAZON_RANK=50000         # reject Amazon deals ranked worse than this
TGTBT_RATIO=0.20              # buy_cost below this fraction of resale => scam flag
ALLOW_FOR_PARTS=false         # allow "for parts / not working" listings

# --- Liquidity / risk model -------------------------------------------------
BASE_SELL_PROBABILITY=0.75    # assumed sale probability before any observed data
DEFAULT_DAYS_TO_SELL=21       # assumed days to sell before any observed data
CAPITAL_ANNUAL_COST_PCT=12    # annualised cost of capital tied up in stock (%)

# --- Fee model (tune to your real seller fees) ------------------------------
# The engine is only as honest as these numbers. Optimistic fees turn losers
# into false "deals", and you find out weeks later from the payouts.
EBAY_FVF_PCT=12.8             # eBay final value fee %
EBAY_FIXED_FEE=0.30           # eBay per-order fixed fee (£)
EBAY_PAYMENT_PCT=0.0          # extra payment processing %, if any
EBAY_AD_RATE_PCT=0.0          # Promoted Listings ad rate %, if you run them
EBAY_FVF_CAP=                 # optional cap on the FVF portion (£)
POSTAGE_COST=3.50             # what it costs you to post an item (£)
PACKAGING_COST=2.50           # packaging cost per item (£)
AMAZON_REFERRAL_PCT=8         # Amazon referral fee %
AMAZON_FBA_FEE=3.0            # flat FBA fulfilment estimate (£)

# --- API server -------------------------------------------------------------
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Scraping (Gumtree / Facebook Marketplace) ------------------------------
# NOTE: scraping these sites violates their ToS (civil, not criminal). Off by
# default, and not needed — eBay alone is the focus.
ENABLE_GUMTREE=false
ENABLE_FB_MARKETPLACE=false
SCRAPE_QUERIES=
SCRAPE_MAX_PRICE=
SCRAPE_LOCATION=
SCRAPE_DEFAULT_SHIPPING=0.0
SCRAPE_MIN_DELAY_SEC=4
SCRAPE_MAX_DELAY_SEC=12

# --- Pipeline behaviour -----------------------------------------------------
DRY_RUN=false
