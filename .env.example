# ---------------------------------------------------------------------------
# Electronics Arbitrage Bot — configuration
# Copy to `.env` and fill in. Every variable is documented below.
# ---------------------------------------------------------------------------

# --- Runtime / storage ------------------------------------------------------
ENV=dev                       # "dev" (pretty logs) or "prod" (JSON logs)
LOG_LEVEL=INFO
DB_PATH=data/arb.db           # SQLite file (mounted as a volume in Docker)

# --- eBay Browse / Marketplace Insights API ---------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_GB
EBAY_HAS_INSIGHTS=false        # true only if your account tier has sold data
EBAY_QUERIES=                  # comma-separated search terms, e.g. "iphone 12,ps5,sony wh-1000xm4"
EBAY_CATEGORY_ID=              # optional eBay category id (e.g. 9355 = mobile phones)
EBAY_MAX_PRICE=                # optional max buy-it-now price to consider
EBAY_LIMIT=50                  # max results per query

# --- Keepa (Amazon data) ----------------------------------------------------
KEEPA_API_KEY=
KEEPA_DOMAIN=2                 # 1=US, 2=UK, 3=DE ... match your marketplace

# --- Notifications ----------------------------------------------------------
# Alerts are off for now. Deals are still evaluated and stored in the database
# (arb.db); nothing is pushed to an external channel.

# --- Deal thresholds --------------------------------------------------------
MIN_PROFIT=25                  # minimum £ profit to flag a deal
MIN_ROI=30                     # minimum ROI %
MIN_SOLD_COUNT=3               # minimum eBay sold comps before trusting the median
MAX_AMAZON_RANK=50000          # reject Amazon deals ranked worse than this
TGTBT_RATIO=0.20               # buy_cost below this fraction of resale => scam flag
ALLOW_FOR_PARTS=false          # allow "for parts / not working" listings

# --- Fee model (tune to your real seller fees) ------------------------------
EBAY_FVF_PCT=12.8              # eBay final value fee %
EBAY_FIXED_FEE=0.30            # eBay per-order fixed fee (£)
EBAY_PAYMENT_PCT=0.0           # extra payment processing %, if any
AMAZON_REFERRAL_PCT=8          # Amazon referral fee %
AMAZON_FBA_FEE=3.0             # flat FBA fulfilment estimate (£)
PACKAGING_COST=2.50            # packaging cost per item (£)

# --- Caching ----------------------------------------------------------------
VALUATION_TTL_HOURS=24         # re-query a valuation only if older than this

# --- Scraping (Gumtree / Facebook Marketplace) ------------------------------
# NOTE: scraping these sites violates their ToS (civil, not criminal). Off by default.
ENABLE_GUMTREE=false
ENABLE_FB_MARKETPLACE=false
SCRAPE_QUERIES=                # comma-separated search terms for scraper sources
SCRAPE_MAX_PRICE=              # optional max price for scraper searches
SCRAPE_LOCATION=               # location / postcode for location-scoped searches
SCRAPE_DEFAULT_SHIPPING=0.0    # assumed shipping for collection-only listings
SCRAPE_MIN_DELAY_SEC=4
SCRAPE_MAX_DELAY_SEC=12

# --- Pipeline behaviour -----------------------------------------------------
DRY_RUN=false                  # scan + evaluate but never send alerts
